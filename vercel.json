{
  "rewrites": [
    {
      "source": "/api/openapi.json",
      "destination": "/api/rtc-openapi"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/muse-client.json",
      "destination": "/api/well-known/muse-client"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/connection",
      "destination": "/api/connection"
    },
    {
      "source": "/brand/icon-256.png",
      "destination": "/api/index?brand_icon=256"
    },
    {
      "source": "/brand/icon-64.png",
      "destination": "/api/index?brand_icon=64"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "live": true
    }
  }
}
